# Public origin of this server (https required except for localhost).
PUBLIC_URL=http://localhost:3000
PORT=3000
DATABASE_PATH=data/ftgnome.sqlite

# 42 OAuth app: https://profile.intra.42.fr/oauth/applications/new
# Redirect URI must be exactly: ${PUBLIC_URL}/auth/callback
FT_CLIENT_UID=
FT_CLIENT_SECRET=

# Cloudflare Turnstile. The values below are Cloudflare's always-pass TEST keys,
# fine for local development only.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SITE_SECRET=1x0000000000000000000000000000000AA

# 32 random bytes, base64. Generate with: bun run gen-key
# Encrypts stored 42 tokens. Rotating it forces every user to log in again.
ENCRYPTION_KEY=

# Client IP source: none | cloudflare (CF-Connecting-IP) | x-forwarded-for
# Only set this when the server is actually behind that proxy.
TRUST_PROXY=none
